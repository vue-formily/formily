{
  "name": "@vue-formily/formily",
  "version": "2.0.0-beta.7",
  "description": "Simple, lightweight, and flexible schema-based form for Vue.js",
  "author": "An Ha",
  "license": "MIT",
  "type": "module",
  "main": "./dist/formily.js",
  "module": "./dist/formily.esm.js",
  "unpkg": "dist/formily.js",
  "types": "./dist/formily.d.ts",
  "exports": {
    ".": {
      "types": "./dist/formily.d.ts",
      "import": "./dist/formily.esm.js",
      "require": "./dist/formily.js",
      "default": "./dist/formily.js"
    },
    "./package.json": "./package.json"
  },
  "homepage": "https://vue-formily.netlify.app",
  "repository": "https://github.com/vue-formily/formily",
  "sideEffects": false,
  "keywords": [
    "vue",
    "validation",
    "form",
    "schema"
  ],
  "files": [
    "dist",
    "esm"
  ],
  "scripts": {
    "test": "NODE_ENV=test vitest",
    "build": "tsx scripts/build.ts && tsc-alias --outDir esm",
    "lint": "eslint . '**/*.{js,jsx,ts,tsx}' --fix",
    "format": "prettier \"./**/*.ts\" --write",
    "prepare": "husky install",
    "release": "bash scripts/release.sh",
    "release:note": "node scripts/release-note.js",
    "commit": "git-cz"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-typescript": "^7.28.5",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^13.1.0",
    "@eslint/js": "^9.39.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@types/fs-extra": "^11.0.4",
    "@types/shelljs": "^0.10.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue-formily/string-format": "^0.1.3",
    "@vue/test-utils": "^2.4.5",
    "commitizen": "^4.2.4",
    "conventional-changelog": "^3.1.24",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "filesize": "^6.1.0",
    "flush-promises": "^1.0.2",
    "fs-extra": "^9.0.1",
    "globals": "^17.0.0",
    "gzip-size": "^6.0.0",
    "husky": "^7.0.2",
    "jsdom": "^24.0.0",
    "lint-staged": "^10.5.3",
    "np": "^10.0.5",
    "prettier": "^3.8.0",
    "rollup": "^4.46.4",
    "rollup-plugin-dts": "^6.2.3",
    "rollup-plugin-typescript2": "^0.29.0",
    "shelljs": "^0.8.4",
    "terser": "^5.5.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.53.0",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "vue": "^3.5.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.js": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@vue-formily/util": "^0.1.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
